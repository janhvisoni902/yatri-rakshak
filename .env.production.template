# =============================================================================
# YATRI RAKSHAK - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local for production deployment
# Replace all placeholder values with your actual production values

# =============================================================================
# NEXTAUTH CONFIGURATION (REQUIRED)
# =============================================================================
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_production_nextauth_secret_here_generate_using_openssl

# Your production domain URL (update with your actual domain)
NEXTAUTH_URL=https://your-production-domain.com

# =============================================================================
# MONGODB DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
# MongoDB Atlas Production URI
# Format: mongodb+srv://username:password@cluster-name.xxxxx.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://yatri_user:REPLACE_WITH_YOUR_PASSWORD@yatrirakshak-cluster.xxxxx.mongodb.net/yatrirakshak?retryWrites=true&w=majority

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment mode
NODE_ENV=production

# Application settings
APP_NAME=Yatri Rakshak
APP_VERSION=1.0.0
APP_DESCRIPTION=Smart Tourist Safety System - Government of India

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Token Expiration (in seconds)
JWT_EXPIRES_IN=86400

# Session Configuration
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

# Password Security
BCRYPT_SALT_ROUNDS=12

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL - FOR NOTIFICATIONS)
# =============================================================================
# SMTP Configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Templates
FROM_EMAIL=noreply@yatrirakshak.gov.in
ADMIN_EMAIL=admin@yatrirakshak.gov.in

# =============================================================================
# SMS CONFIGURATION (OPTIONAL - FOR EMERGENCY ALERTS)
# =============================================================================
# Twilio or similar SMS service
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
SMS_FROM_NUMBER=+1234567890

# =============================================================================
# FILE STORAGE CONFIGURATION (OPTIONAL)
# =============================================================================
# AWS S3 or similar cloud storage for file uploads
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=yatrirakshak-files

# =============================================================================
# MONITORING & ANALYTICS (OPTIONAL)
# =============================================================================
# Application monitoring
SENTRY_DSN=your-sentry-dsn-url

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# =============================================================================
# EXTERNAL API INTEGRATIONS (OPTIONAL)
# =============================================================================
# Weather API for safety alerts
WEATHER_API_KEY=your-weather-api-key

# Maps API for location services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Emergency Services API
EMERGENCY_SERVICES_API_KEY=your-emergency-api-key

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================
# Rate limiting (requests per minute)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# CORS Origins (comma-separated)
CORS_ORIGINS=https://your-production-domain.com,https://admin.your-domain.com

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log retention (days)
LOG_RETENTION_DAYS=30

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database backup settings
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# =============================================================================
# PRODUCTION OPTIMIZATIONS
# =============================================================================
# Enable production optimizations
NEXT_TELEMETRY_DISABLED=1
DISABLE_SOURCE_MAPS=true

# CDN Configuration (if using)
CDN_URL=https://cdn.your-domain.com

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Port for production server (if needed)
PORT=3000

# Health check endpoint
HEALTH_CHECK_PATH=/api/health

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
